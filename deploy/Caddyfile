{$NAFIR_DOMAIN} {
  handle /api/* {
    encode zstd gzip
    reverse_proxy api:8080
  }

  # Presigned audio URLs. Keep media responses byte-for-byte: content encoding
  # is lossless, but it can interfere with Range requests and media caches.
  # no-transform also prevents downstream proxies from modifying the object.
  handle /nafir-music/* {
    header Cache-Control "private, no-transform"
    reverse_proxy minio:9000
  }

  handle {
    encode zstd gzip
    reverse_proxy web:80
  }
}
