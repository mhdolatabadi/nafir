{$NAFIR_DOMAIN} {
  handle /api/* {
    encode zstd gzip
    reverse_proxy api:8080 {
      header_up X-Nafir-Client-IP {remote_host}
    }
  }

  # Presigned audio URLs. Keep media responses byte-for-byte: content encoding
  # is lossless, but it can interfere with Range requests and media caches.
  # no-transform also prevents downstream proxies from modifying the object.
  # Presigned POSTs target the bare bucket path; object reads include a suffix.
  @musicStorage path /nafir-music /nafir-music/*
  handle @musicStorage {
    header Cache-Control "private, no-transform"
    reverse_proxy minio:9000
  }

  # Share and collaboration links from before the app moved to /app keep working.
  @legacyShare {
    path /
    query shared=*
  }
  handle @legacyShare {
    redir * /app/?{query} 302
  }
  @legacyCollab {
    path /
    query collab=*
  }
  handle @legacyCollab {
    redir * /app/?{query} 302
  }

  # Store and support pages must stay outside the Flutter app.
  @publicLegal path /privacy /delete-account
  handle @publicLegal {
    encode zstd gzip
    reverse_proxy api:8080 {
      header_up X-Nafir-Client-IP {remote_host}
    }
  }

  # The Flutter web app.
  handle /app {
    redir * /app/ 308
  }
  handle /app/* {
    encode zstd gzip
    reverse_proxy web:80
  }

  # Everything else is the public site the API renders: the front page,
  # /p/{token} playlist pages, sitemap.xml, robots.txt and static public assets. The client IP
  # header feeds the per-visitor rate limits.
  handle {
    encode zstd gzip
    reverse_proxy api:8080 {
      header_up X-Nafir-Client-IP {remote_host}
    }
  }
}
