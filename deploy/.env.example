NAFIR_DOMAIN=music.example.com
# Use a URL-safe value, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Signs login tokens; changing it signs everyone out. Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=replace-with-64-hex-characters
# The API also uses these to manage the private music bucket.
MINIO_ROOT_USER=nafir-storage-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
# Upload abuse controls. Quota includes ready and pending tracks.
MAX_UPLOAD_BYTES=209715200
STORAGE_QUOTA_BYTES=1073741824
MAX_PENDING_UPLOADS=3
# Embedded tag rewrites after metadata edits run at once; each needs up to
# twice the largest upload of free space in the API container's /tmp.
TAG_REWRITE_WORKERS=1
# Pending reservations older than this are removed from MinIO and PostgreSQL.
PENDING_UPLOAD_TTL=2h
PENDING_CLEANUP_INTERVAL=10m
PENDING_CLEANUP_BATCH=100
# Emergency switch: false blocks new reservations but keeps playback working.
UPLOADS_ENABLED=true
# Per-process fixed-window request limits. Caddy supplies the trusted client IP.
REGISTER_RATE_REQUESTS=5
REGISTER_RATE_WINDOW=1h
LOGIN_RATE_REQUESTS=30
LOGIN_RATE_WINDOW=15m
# Account deletion attempts (each checks a password), per account and per IP.
ACCOUNT_DELETE_RATE_REQUESTS=5
ACCOUNT_DELETE_RATE_WINDOW=1h
UPLOAD_RESERVATION_USER_RATE_REQUESTS=120
UPLOAD_RESERVATION_USER_RATE_WINDOW=10m
UPLOAD_RESERVATION_IP_RATE_REQUESTS=240
UPLOAD_RESERVATION_IP_RATE_WINDOW=10m
UPLOAD_COMPLETION_USER_RATE_REQUESTS=240
UPLOAD_COMPLETION_USER_RATE_WINDOW=10m
UPLOAD_COMPLETION_IP_RATE_REQUESTS=480
UPLOAD_COMPLETION_IP_RATE_WINDOW=10m
# Visitors without an account may browse and play public playlists; these
# cap each IP address. Signed-in people are not counted.
PUBLIC_VIEW_RATE_REQUESTS=300
PUBLIC_VIEW_RATE_WINDOW=10m
PUBLIC_STREAM_RATE_REQUESTS=300
PUBLIC_STREAM_RATE_WINDOW=10m
# Plays one user may add to their recently played history.
HISTORY_RATE_REQUESTS=60
HISTORY_RATE_WINDOW=10m
# Messenger bots (optional; each stays off while its token is empty).
# Tokens and usernames come from @BotFather in each messenger. The webhook
# secret is shared by all bots: openssl rand -hex 32
BOT_WEBHOOK_SECRET=
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Telegram is unreachable from servers in Iran; route it through a proxy,
# for example socks5://user:pass@host:1080 or http://host:3128
TELEGRAM_PROXY_URL=
# Operator token for GET /api/v1/ops/bots (bot webhook and import queue
# health); deploy.sh uses it to check the bots after each deploy. Leave empty
# to disable the endpoint. openssl rand -hex 32
OPS_TOKEN=

# The email the public /privacy and /delete-account pages give for questions
# and account deletion; app stores such as Cafe Bazaar link to both pages.
PRIVACY_CONTACT_EMAIL=
# Optional https link the public front page offers for installing the
# Android app, such as its Cafe Bazaar page.
ANDROID_APP_URL=
# Prebuilt images published by .github/workflows/images.yml
NAFIR_IMAGE_REPO=ghcr.io/mhdolatabadi/nafir

# Existing accounts allowed to open the admin panel (comma-separated).
# Register these accounts before adding them; this does not create accounts.
ADMIN_EMAILS=
